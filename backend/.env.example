# Backend Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3000
NODE_ENV=development

# Database
# Development: SQLite (uses schema.dev.prisma)
DATABASE_URL="file:./prisma/dev.db"
# Production: PostgreSQL on Supabase (uses schema.prisma)
# DATABASE_URL="postgresql://postgres:PASSWORD@db.XX.supabase.co:5432/postgres"

# Redis
# Development: Local Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Production: Upstash (use URL format instead)
# REDIS_URL="redis://default:PASSWORD@XX.upstash.io:6379"

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Logging
LOG_LEVEL=info

# Business Rules
WEIGHING_TOLERANCE_CG=50
