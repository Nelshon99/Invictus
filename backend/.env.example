# Backend Environment Variables

# Server
PORT=3000
NODE_ENV=development

# Database - PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invictus_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Logging
LOG_LEVEL=info

# Business Rules
WEIGHING_TOLERANCE_CG=50
